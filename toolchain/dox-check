#!/usr/bin/env python3
"""Validate DOX ownership, child indexes, section shape and local document links."""
from pathlib import Path
import os
import re
import sys
from urllib.parse import unquote, urlsplit

SKIP = {'.git', '.local', '.superpowers', '.claude', '.dart_tool', '.gradle',
        'node_modules', 'build', '__pycache__', '.venv', 'vendor'}
SECTIONS = ['Purpose', 'Ownership', 'Local Contracts', 'Work Guidance', 'Verification', 'Child DOX Index']


def documents(root):
    for directory, folders, files in os.walk(root):
        folders[:] = [folder for folder in folders if folder not in SKIP]
        for name in files:
            if name.endswith('.md'):
                yield Path(directory) / name


def check(root):
    docs = sorted(documents(root))
    agents = [path for path in docs if path.name == 'AGENTS.md']
    errors = []
    if root / 'AGENTS.md' not in agents:
        return ['root owner AGENTS.md is missing']
    for path in agents:
        text = path.read_text()
        headings = re.findall(r'^#+\s+(.+?)\s*$', text, re.M)
        if path != root / 'AGENTS.md':
            positions = [headings.index(section) if section in headings else -1 for section in SECTIONS]
            if -1 in positions or positions != sorted(positions):
                errors.append(f'{path.relative_to(root)}: missing or unordered DOX sections')
        match = re.search(r'^#+\s+Child DOX Index\s*\n(.*?)(?=^#+\s|\Z)', text, re.M | re.S)
        if not match:
            errors.append(f'{path.relative_to(root)}: missing child index')
            continue
        references = set(re.findall(r'`([^`\n]*AGENTS\.md)`', match.group(1)))
        references.update(re.findall(r'\]\(([^)\n]*AGENTS\.md)\)', match.group(1)))
        expected = set()
        for candidate in agents:
            if candidate == path or path.parent not in candidate.parents:
                continue
            parents = [owner for owner in agents if owner != candidate and owner.parent in candidate.parents]
            nearest = max(parents, key=lambda owner: len(owner.parts))
            if nearest == path:
                expected.add(candidate.relative_to(path.parent).as_posix())
        if references != expected:
            missing, extra = expected - references, references - expected
            errors.append(f'{path.relative_to(root)}: child index missing {sorted(missing)}, extra {sorted(extra)}')
    for source in (root / 'server').rglob('*.go') if (root / 'server').exists() else []:
        if source.parent / 'AGENTS.md' not in agents:
            errors.append(f'{source.relative_to(root)}: Go package needs a local owner')
    lib = root / 'app/lib'
    if lib.exists():
        for layer in lib.iterdir():
            if layer.is_dir() and list(layer.glob('*.dart')) and layer / 'AGENTS.md' not in agents:
                errors.append(f'{layer.relative_to(root)}: Flutter layer needs a local owner')
    for path in docs:
        for target in re.findall(r'\]\(([^)\s]+)\)', path.read_text()):
            if urlsplit(target).scheme or target.startswith('#'):
                continue
            target = unquote(target.split('#')[0])
            if target and not (path.parent / target).exists():
                errors.append(f'{path.relative_to(root)}: broken link {target}')
    return errors


def main():
    errors = check(Path(__file__).resolve().parent.parent)
    if errors:
        print('\n'.join(errors), file=sys.stderr)
        return 1
    print('PASS: DOX owners, direct child indexes, section shapes and local links.')
    return 0


if __name__ == '__main__':
    sys.exit(main())
