#!/usr/bin/env python3
"""Check production imports against the approved package and layer boundaries."""
import json
from pathlib import Path
import re
import subprocess
import sys

ROOT = Path(__file__).resolve().parent.parent
MODULE = 'github.com/alexanderp4580/Minder/server/'
GO = {
    'domain': set(), 'port': {'domain'},
    'command': {'domain', 'port'}, 'assistant': {'domain', 'port'},
    'reminder': {'domain', 'port'}, 'conversation': {'domain'},
    'capture': {'domain','port'}, 'mailauth': {'domain','config'}, 'mailparse': {'domain'}, 'mailfiles': set(), 'store': {'domain', 'port'}, 'openrouter': {'domain', 'assistant'}, 'serper': {'domain', 'assistant'},
    'push': set(), 'access': set(), 'config': set(),
    'api': {'domain', 'conversation'},
    'cmd/minder': {'domain', 'access', 'api', 'assistant', 'command', 'config',
                   'conversation', 'openrouter', 'serper', 'push', 'reminder', 'store', 'capture', 'mailauth', 'mailfiles', 'mailparse'},
}
INNER = {'domain', 'port', 'command', 'assistant', 'reminder', 'conversation', 'capture'}
INFRASTRUCTURE = {'net', 'database/sql', 'os', 'syscall'}
LAYERS = {
    'domain': {'domain'},
    'application': {'domain', 'application'},
    'data': {'domain', 'data'},
    'ui': {'domain', 'application', 'ui'},
}
DART_TRANSPORT = {'dart:io', 'dart:ffi', 'dart:js_interop', 'dart:html'}


def go_errors(packages):
    errors = []
    for package in packages:
        name = package['ImportPath'].removeprefix(MODULE)
        if name not in GO:
            errors.append(f'{name}: package has no declared boundary')
            continue
        for dependency in package.get('Imports', []):
            if dependency.startswith(MODULE):
                target = dependency.removeprefix(MODULE)
                if target not in GO[name]:
                    errors.append(f'{name} imports {target}')
            elif name in INNER and (
                '.' in dependency.split('/')[0]
                or any(dependency == prefix or dependency.startswith(prefix + '/')
                       for prefix in INFRASTRUCTURE)):
                errors.append(f'{name} imports infrastructure {dependency}')
    return errors


def dart_errors(root):
    errors = []
    lib = root / 'app/lib'
    for path in lib.rglob('*.dart'):
        parts = path.relative_to(lib).parts
        if len(parts) < 2:
            continue
        layer = parts[0]
        if layer not in LAYERS:
            errors.append(f'{path.relative_to(root)}: layer has no declared boundary')
            continue
        directives = re.findall(r"(?:import|export|part)\s+[^;]+;", path.read_text())
        imports = [uri for directive in directives
                   for uri in re.findall(r"['\"]([^'\"]+)['\"]", directive)]
        for imported in imports:
            target = None
            if imported.startswith('package:minder/'):
                target = imported.split('/')[1]
            elif not imported.startswith(('package:', 'dart:')):
                try:
                    target = (path.parent / imported).resolve().relative_to(lib).parts[0]
                except ValueError:
                    errors.append(f'{path.relative_to(root)}: import escapes lib')
            if target is not None and target not in LAYERS[layer]:
                errors.append(f'{path.relative_to(root)} imports {imported}')
            if layer in {'domain', 'application', 'ui'} and imported in DART_TRANSPORT:
                errors.append(f'{path.relative_to(root)}: transport belongs in data')
            own_package = imported.startswith('package:minder/')
            if layer == 'domain' and imported.startswith('package:') and not own_package:
                errors.append(f'{path.relative_to(root)}: domain depends on a framework')
            if (layer == 'application' and imported.startswith('package:')
                    and not own_package and imported != 'package:flutter/foundation.dart'):
                errors.append(f'{path.relative_to(root)}: application depends on a transport or UI framework')
    return errors


def main():
    result = subprocess.run([str(ROOT / 'toolchain/run'), 'go', 'go', 'list', '-json', './...'],
                            cwd=ROOT, capture_output=True, text=True)
    if result.returncode:
        print(result.stderr, file=sys.stderr)
        return result.returncode
    raw, decoder, packages = result.stdout, json.JSONDecoder(), []
    while raw.strip():
        package, end = decoder.raw_decode(raw.lstrip())
        raw = raw.lstrip()[end:]
        packages.append(package)
    errors = go_errors(packages)
    errors.extend(dart_errors(ROOT))
    if errors:
        print('\n'.join(errors), file=sys.stderr)
        return 1
    print('PASS: Go package and Flutter layer dependencies.')
    return 0


if __name__ == '__main__':
    sys.exit(main())
